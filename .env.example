# Copy this file to .env.local and fill in real values.
# Gmail example: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
# Optional. Defaults to 465 (implicit TLS) if omitted.
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-character-app-password
# Where contact-form messages should arrive
CONTACT_TO=vimalbalaji.p@northeastern.edu
